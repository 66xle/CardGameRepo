        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "\"Stop! You shouldn\u2019t be out here after dark. What are you doing?\""
        type: 0
        typeString: 
      conversationID: 20000
      isRoot: 0
      isGroup: 0
      nodeColor: 
