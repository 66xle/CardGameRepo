    - id: 2
      fields:
      - title: Title
        value: Dialogue
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: '"Who are you looking for?"'
        type: 0
        typeString: 
      - title: Actor
        value: 10000
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: "I\u2019m looking for someone."
        type: 0
        typeString: 
      conversationID: 20000
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: 
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 20000
        originDialogueID: 2
        destinationConversationID: 20000
        destinationDialogueID: 5
        isConnector: 0
        priority: 2
      - originConversationID: 20000
        originDialogueID: 2
        destinationConversationID: 20000
        destinationDialogueID: 6
        isConnector: 0
        priority: 2
      conditionsString: (Variable["OnlyOnce.acce0711db45464e846e762f0b7ab5d5"] ==
        false)
