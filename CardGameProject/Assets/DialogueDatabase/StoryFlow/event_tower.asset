        width: 160
        height: 30
    - id: 3
      fields:
      - title: Title
        value: Dialogue
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "\"Fine. Walk away, then. Just don\u2019t blame me for what happens
          next.\""
        type: 0
        typeString: 
      - title: Actor
        value: 10000
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: "That\u2019s none of your business."
        type: 0
        typeString: 
      conversationID: 20000
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: 
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 20000
        originDialogueID: 3
        destinationConversationID: 20000
        destinationDialogueID: 7
        isConnector: 0
        priority: 2
      - originConversationID: 20000
        originDialogueID: 3
        destinationConversationID: 20000
        destinationDialogueID: 8
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 0
        y: 0
        width: 160
        height: 30
    - id: 4
      fields:
      - title: Title
        value: Dialogue
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: '"Help? Perhaps. But first, tell me something. Do you believe in monsters?"'
        type: 0
        typeString: 
      - title: Actor
        value: 10000
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: I got lost. Can you help me?
        type: 0
        typeString: 
      conversationID: 20000
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: 
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 20000
        originDialogueID: 4
        destinationConversationID: 20000
        destinationDialogueID: 9
        isConnector: 0
        priority: 2
      - originConversationID: 20000
        originDialogueID: 4
        destinationConversationID: 20000
        destinationDialogueID: 10
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 0
        y: 0
        width: 160
        height: 30
    - id: 5
      fields:
      - title: Title
        value: Dialogue
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: "\"...Then you\u2019d better come with me. I think I know where he
          is.\""
        type: 0
        typeString: 
      - title: Actor
        value: 10000
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: My brother. He disappeared yesterday.
        type: 0
        typeString: 
      conversationID: 20000
      isRoot: 0
      isGroup: 0
      nodeColor: 
      delaySimStatus: 0
      falseConditionAction: 
      conditionPriority: 2
      outgoingLinks:
      - originConversationID: 20000
        originDialogueID: 5
        destinationConversationID: 20000
        destinationDialogueID: 2
        isConnector: 0
        priority: 2
      conditionsString: 
      userScript: 
      onExecute:
        m_PersistentCalls:
          m_Calls: []
      canvasRect:
        serializedVersion: 2
        x: 0
        y: 0
        width: 160
        height: 30
    - id: 6
      fields:
      - title: Title
        value: Dialogue
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: '"Then I suggest you turn around before you find more trouble than
