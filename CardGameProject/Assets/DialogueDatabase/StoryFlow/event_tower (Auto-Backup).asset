      - title: Title
        value: Dialogue
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "\"Fine. Walk away, then. Just don\u2019t blame me for what happens
