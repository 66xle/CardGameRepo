    - id: 3
      fields:
      - title: Title
        value: Dialogue
        type: 0
        typeString: CustomFieldType_Text
      - title: Sequence
        value: 
        type: 0
        typeString: CustomFieldType_Text
      - title: Dialogue Text
        value: "\"...Then you\u2019d better come with me. I think I know where he
