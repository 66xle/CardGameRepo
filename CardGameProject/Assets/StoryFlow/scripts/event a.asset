  serializedStrings:
  - Key: en.8dcb52f1c4194f9fa1fd7f97baccd271.title
    Value: Dialogue
  - Key: en.8dcb52f1c4194f9fa1fd7f97baccd271.text
    Value: "\"Stop! You shouldn\u2019t be out here after dark. What are you doing?\""
  - Key: en.acce0711db45464e846e762f0b7ab5d5
    Value: "I\u2019m looking for someone."
  - Key: en.1fc9d7d446a3488b8b58f94efa83bf56
    Value: "That\u2019s none of your business."
  - Key: en.4e279bdb638b454c9fb3ecd6f43d068d
    Value: I got lost. Can you help me?
  - Key: en.bb1a8aa0184c44d881ed78c3cab49ba1.title
    Value: Dialogue
  - Key: en.bb1a8aa0184c44d881ed78c3cab49ba1.text
    Value: '"Who are you looking for?"'
  - Key: en.e66749a2e8b641db8a730e715cfb12fe
    Value: My brother. He disappeared yesterday.
  - Key: en.7eade094f16f4b46b39f4bf9e18893d3
    Value: Someone who owes me a favour.
  - Key: en.b5d32e156ea74dc68133aaa23a018bd8.title
    Value: Dialogue
  - Key: en.b5d32e156ea74dc68133aaa23a018bd8.text
    Value: "\"...Then you\u2019d better come with me. I think I know where he is.\""
  - Key: en.194fb74ae84846a18263ae76c1ad0909.title
    Value: Dialogue
  - Key: en.194fb74ae84846a18263ae76c1ad0909.text
    Value: '"Then I suggest you turn around before you find more trouble than you
      bargained for."'
  - Key: en.f9b93af420e04db0ab2046a6b9cfdc7e.title
    Value: Dialogue
  - Key: en.f9b93af420e04db0ab2046a6b9cfdc7e.text
    Value: "\"Fine. Walk away, then. Just don\u2019t blame me for what happens next.\""
  - Key: en.67a4a6b2e79048e290fc9132d61f2cfa
    Value: Wait. What do you know?
  - Key: en.3ff98596747c4f7e81b880ec6904b6c0
    Value: '*Walk away*.'
  - Key: en.9e3cbc031e5c4b969dcc3ac5a5a9740f.title
    Value: Dialogue
  - Key: en.9e3cbc031e5c4b969dcc3ac5a5a9740f.text
    Value: '"The forest is watching you. And it knows your name."'
  - Key: en.569ccc584e02459a97c6bda0d728e5d9.title
    Value: Dialogue
  - Key: en.569ccc584e02459a97c6bda0d728e5d9.text
    Value: '*A distant scream echoes through the trees.*'
  - Key: en.12a8320e60684e2ebee5f2df96e4938c.title
    Value: Dialogue
  - Key: en.12a8320e60684e2ebee5f2df96e4938c.text
    Value: '"Help? Perhaps. But first, tell me something. Do you believe in monsters?"'
  - Key: en.03fdae86a36144eca2592fcbeb6c8ad1
    Value: "No. Monsters aren\u2019t real."
  - Key: en.52c5ad7097ea42429c8120b98973af6b
    Value: "I\u2019ve seen things you wouldn\u2019t believe."
  - Key: en.49264807ec144252a875b16c14289000.title
    Value: Dialogue
  - Key: en.49264807ec144252a875b16c14289000.text
    Value: "Slowly smiles. \u201CThen you won\u2019t mind meeting one.\u201D"
  - Key: en.4499cc06c83a41f2acac5e8c76b5b4ca.title
    Value: Dialogue
  - Key: en.4499cc06c83a41f2acac5e8c76b5b4ca.text
    Value: "\u201CGood. Then perhaps you\u2019ll survive the night.\u201D"
  - Key: en.c0113aac794a469dbba2c745e3ded960.title
    Value: Dialogue
