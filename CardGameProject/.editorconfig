root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
dotnet_style_operator_placement_when_wrapping = beginning_of_line
tab_width = 4
indent_size = 4
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:suggestion
dotnet_style_prefer_auto_properties = true:silent
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_simplified_boolean_expressions = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:silent
dotnet_style_prefer_conditional_expression_over_return = true:silent
dotnet_style_explicit_tuple_names = true:suggestion
dotnet_style_prefer_inferred_tuple_names = true:suggestion
dotnet_style_prefer_inferred_anonymous_type_member_names = true:suggestion
dotnet_style_prefer_compound_assignment = true:suggestion
dotnet_style_prefer_simplified_interpolation = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
dotnet_style_namespace_match_folder = true:suggestion
dotnet_style_readonly_field = true:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:silent
dotnet_style_predefined_type_for_member_access = true:silent
dotnet_style_require_accessibility_modifiers = for_non_interface_members:silent
dotnet_style_allow_multiple_blank_lines_experimental = true:silent
dotnet_style_allow_statement_immediately_after_block_experimental = true:silent
dotnet_code_quality_unused_parameters = all:suggestion
dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity:silent
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity:silent
dotnet_style_parentheses_in_relational_binary_operators = always_for_clarity:silent
dotnet_style_parentheses_in_other_operators = never_if_unnecessary:silent
dotnet_style_qualification_for_field = false:silent
dotnet_style_qualification_for_property = false:silent
dotnet_style_qualification_for_method = false:silent
dotnet_style_qualification_for_event = false:silent

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

# Project C# coding style
# - Non-serialized private fields start with an underscore (e.g., _myField)
# - Fields exposed in the Unity Inspector (public or [SerializeField]) use PascalCase
# - Public members, properties, methods, classes use PascalCase

# Naming styles
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case

# Leading-underscore style: require underscore + camelCase
dotnet_naming_style.leading_underscore.required_prefix = _
dotnet_naming_style.leading_underscore.capitalization = camel_case

# Symbols
# Inspector fields: public fields and private fields with SerializeField attribute
dotnet_naming_symbols.inspector_fields.applicable_kinds = field
dotnet_naming_symbols.inspector_fields.applicable_accessibilities = public

# dotnet_naming_symbols.serialized_private_fields.applicable_kinds = field
# dotnet_naming_symbols.serialized_private_fields.applicable_accessibilities = private
# dotnet_naming_symbols.serialized_private_fields.applicable_attributes = UnityEngine.SerializeFieldAttribute

dotnet_naming_symbols.private_fields_with_underscore.applicable_kinds = field
dotnet_naming_symbols.private_fields_with_underscore.applicable_accessibilities = private, internal

dotnet_naming_symbols.properties.applicable_kinds = property
dotnet_naming_symbols.properties.applicable_accessibilities = public, internal, private, protected

# Rules
# Inspector fields must be PascalCase
dotnet_naming_rule.inspector_fields.severity = warning
dotnet_naming_rule.inspector_fields.symbols = inspector_fields
dotnet_naming_rule.inspector_fields.style = pascal_case

# dotnet_naming_rule.serialized_private_fields.severity = warning
# dotnet_naming_rule.serialized_private_fields.symbols = serialized_private_fields
# dotnet_naming_rule.serialized_private_fields.style = pascal_case

# Private fields should start with underscore and be camelCase
dotnet_naming_rule.private_fields_with_underscore.severity = warning
dotnet_naming_rule.private_fields_with_underscore.symbols = private_fields_with_underscore
dotnet_naming_rule.private_fields_with_underscore.style = leading_underscore


# Properties and methods PascalCase
dotnet_naming_rule.properties_should_be_pascal.severity = warning
dotnet_naming_rule.properties_should_be_pascal.symbols = properties
dotnet_naming_rule.properties_should_be_pascal.style = pascal_case


# Sort system directives first
dotnet_sort_system_directives_first = true